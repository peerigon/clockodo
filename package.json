{
  "name": "clockodo",
  "version": "0.0.0-semantically-released",
  "description": "Unofficial JavaScript/TypeScript SDK for Clockodo",
  "keywords": [
    "api",
    "sdk",
    "time tracking"
  ],
  "homepage": "https://github.com/peerigon/clockodo#readme",
  "bugs": {
    "url": "https://github.com/peerigon/clockodo/issues"
  },
  "license": "MIT",
  "author": "developers@peerigon.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peerigon/clockodo.git"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/exports/main.exports.d.ts",
      "default": "./dist/exports/main.exports.js"
    },
    "./csv": {
      "types": "./dist/exports/csv.exports.d.ts",
      "default": "./dist/exports/csv.exports.js"
    },
    "./mocks": {
      "types": "./dist/exports/mocks.exports.d.ts",
      "default": "./dist/exports/mocks.exports.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "husky",
    "test": "run-p test:*",
    "test:format": "oxfmt --check .",
    "test:lint": "eslint --max-warnings 0 --cache .",
    "test:types": "tsc",
    "test:unit": "vitest --run",
    "test:publishable": "verify-publishable",
    "test:jsr": "jsr publish --dry-run --allow-dirty",
    "vitest": "vitest",
    "build": "run-s build:*",
    "build:clean": "rimraf dist",
    "build:tsc": "tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings 0 --cache --no-ignore",
    "integration-test": "vitest run --coverage integration.test.ts",
    "prepublishOnly": "run-s build",
    "release": "semantic-release"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "axios": "^1.18.1",
    "map-obj": "^6.0.0",
    "p-limit": "^7.3.1",
    "qs": "^6.14.2"
  },
  "devDependencies": {
    "@djankies/vitest-mcp": "0.5.1",
    "@eslint/mcp": "0.3.9",
    "@peerigon/configs": "^22.4.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/node": "^26.1.1",
    "@types/qs": "^6.15.1",
    "@vitest/coverage-v8": "^4.1.10",
    "env-var": "^7.5.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jsr": "^0.14.3",
    "lint-staged": "^17.2.0",
    "nock": "^14.0.16",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.65.0",
    "pin-github-action": "^3.5.1",
    "rimraf": "^6.0.1",
    "secretlint": "^13.0.4",
    "semantic-release": "^25.0.8",
    "timezone-mock": "^1.4.2",
    "ts-lsp-mcp": "0.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.5.0",
      "onFail": "error"
    }
  }
}
